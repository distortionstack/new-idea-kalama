port -->\n    <dependency>\n      <groupId>org.osgi</groupId>\n      <artifactId>org.osgi.core</artifactId>\n      <scope>provided</scope>\n    </dependency>\n    <!-- Required for AsyncLoggers -->\n    <dependency>\n      <groupId>com.lmax</groupId>\n      <artifactId>disruptor</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Alternative implementation of BlockingQueue using Conversant Disruptor for AsyncAppender -->\n    <dependency>\n      <groupId>com.conversantmedia</groupId>\n      <artifactId>disruptor</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Alternative implementation of BlockingQueue using JCTools for AsyncAppender -->\n    <dependency>\n      <groupId>org.jctools</groupId>\n      <artifactId>jctools-core</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for JSON support -->\n    <dependency>\n      <groupId>com.fasterxml.jackson.core</groupId>\n      <artifactId>jackson-core</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for JSON support -->\n    <dependency>\n      <groupId>com.fasterxml.jackson.core</groupId>\n      <artifactId>jackson-databind</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for YAML support (including JSON requirements) -->\n    <dependency>\n      <groupId>com.fasterxml.jackson.dataformat</groupId>\n      <artifactId>jackson-dataformat-yaml</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for XML layout and receiver support -->\n    <dependency>\n      <groupId>com.fasterxml.jackson.dataformat</groupId>\n      <artifactId>jackson-dataformat-xml</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- POM for jackson-dataformat-xml depends on woodstox-core -->\n    <dependency>\n      <groupId>com.fasterxml.woodstox</groupId>\n      <artifactId>woodstox-core</artifactId>\n      <version>${woodstox.version}</version>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for console color support in Windows -->\n    <dependency>\n      <groupId>org.fusesource.jansi</groupId>\n      <artifactId>jansi</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Required for SMTPAppender -->\n    <dependency>\n      <groupId>com.sun.mail</groupId>\n      <artifactId>javax.mail</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Used for JMS appenders (needs an implementation of course) -->\n    <dependency>\n      <groupId>org.jboss.spec.javax.jms</groupId>\n      <artifactId>jboss-jms-api_1.1_spec</artifactId>\n      <scope>provided</scope>\n      <optional>true</optional>\n    </dependency>\n    <!-- Used for Kafka appender -->\n    <dependency>\n      <groupId>org.apache.kafka</groupId>\n      <artifactId>kafka-clients</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Used for ZeroMQ JeroMQ appender -->\n    <dependency>\n      <groupId>org.zeromq</groupId>\n      <artifactId>jeromq</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Used for compressing to formats other than zip and gz -->\n    <dependency>\n      <groupId>org.apache.commons</groupId>\n      <artifactId>commons-compress</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Used for the CSV layout -->\n    <dependency>\n      <groupId>org.apache.commons</groupId>\n      <artifactId>commons-csv</artifactId>\n      <optional>true</optional>\n    </dependency>\n    <!-- Kafka needs slf4j -->\n    <dependency>\n      <groupId>org.slf4j</groupId>\n      <artifactId>slf4j-api</artifactId>\n      <optional>true</optional>\n    </dependency>\n\n    <!-- TEST DEPENDENCIES -->\n\n    <!-- Pull in useful test classes from API -->\n    <dependency>\n      <groupId>org.apache.logging.log4j</groupId>\n      <artifactId>log4j-api</artifactId>\n      <type>test-jar</type>\n      <scope>test</scope>\n    </dependency>\n    <!--  Apache Commons Compress -->\n    <dependency>\n      <groupId>org.tukaani</groupId>\n      <artifactId>xz</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Zeroconf advertiser tests -->\n    <dependency>\n      <groupId>org.jmdns</groupId>\n      <artifactId>jmdns</artifactId>\n      <version>3.5.7</version>\n      <scope>test</scope>\n    </dependency>\n    <!-- Log4j 1.2 tests -->\n    <dependency>\n      <groupId>log4j</groupId>\n      <artifactId>log4j</artifactId>\n      <version>1.2.17</version>\n      <scope>test</scope>\n    </dependency>\n    <!-- SLF4J tests -->\n    <dependency>\n      <groupId>org.slf4j</groupId>\n      <artifactId>slf4j-ext</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- JUnit, naturally -->\n    <dependency>\n      <groupId>org.junit.vintage</groupId>\n      <artifactId>junit-vintage-engine</artifactId>\n    </dependency>\n    <dependency>\n      <groupId>org.junit.jupiter</groupId>\n      <artifactId>junit-jupiter-engine</artifactId>\n    </dependency>\n    <dependency>\n      <groupId>org.junit.jupiter</groupId>\n      <artifactId>junit-jupiter-params</artifactId>\n    </dependency>\n    <dependency>\n      <groupId>org.hamcrest</groupId>\n      <artifactId>hamcrest</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Mocking framework for use with JUnit -->\n    <dependency>\n      <groupId>org.mockito</groupId>\n      <artifactId>mockito-core</artifactId>\n    </dependency>\n    <dependency>\n      <groupId>org.mockito</groupId>\n      <artifactId>mockito-junit-jupiter</artifactId>\n    </dependency>\n    <!-- Embedded JDBC drivers for database appender tests -->\n    <dependency>\n      <groupId>org.hsqldb</groupId>\n      <artifactId>hsqldb</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>com.h2database</groupId>\n      <artifactId>h2</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Useful mock classes and utilities -->\n    <dependency>\n      <groupId>org.springframework</groupId>\n      <artifactId>spring-test</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- JNDI and JMS tests -->\n    <dependency>\n      <groupId>org.apache.activemq</groupId>\n      <artifactId>activemq-broker</artifactId>\n      <scope>test</scope>\n      <exclusions>\n        <exclusion>\n          <groupId>org.apache.geronimo.specs</groupId>\n          <artifactId>geronimo-jms_1.1_spec</artifactId>\n        </exclusion>\n      </exclusions>    \n    </dependency>\n    <dependency>\n      <groupId>commons-logging</groupId>\n      <artifactId>commons-logging</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Logback performance tests -->\n    <dependency>\n      <groupId>ch.qos.logback</groupId>\n      <artifactId>logback-core</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>ch.qos.logback</groupId>\n      <artifactId>logback-classic</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- OSGi tests -->\n    <dependency>\n      <groupId>org.eclipse.tycho</groupId>\n      <artifactId>org.eclipse.osgi</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.apache.felix</groupId>\n      <artifactId>org.apache.felix.framework</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.codehaus.plexus</groupId>\n      <artifactId>plexus-utils</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.apache.maven</groupId>\n      <artifactId>maven-core</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!--  GELF -->\n    <dependency>\n      <groupId>net.javacrumbs.json-unit</groupId>\n      <artifactId>json-unit</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.xmlunit</groupId>\n      <artifactId>xmlunit-core</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.xmlunit</groupId>\n      <artifactId>xmlunit-matchers</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>commons-io</groupId>\n      <artifactId>commons-io</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Other -->\n    <dependency>\n      <groupId>commons-codec</groupId>\n      <artifactId>commons-codec</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.apache.commons</groupId>\n      <artifactId>commons-lang3</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.apache-extras.beanshell</groupId>\n      <artifactId>bsh</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.codehaus.groovy</groupId>\n      <artifactId>groovy-jsr223</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.codehaus.groovy</groupId>\n      <artifactId>groovy-dateutil</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- Used for testing HttpAppender -->\n    <dependency>\n      <groupId>com.github.tomakehurst</groupId>\n      <artifactId>wiremock</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <!-- GC-free -->\n    <dependency>\n      <groupId>com.google.code.java-allocation-instrumenter</groupId>\n      <artifactId>java-allocation-instrumenter</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.hdrhistogram</groupId>\n      <artifactId>HdrHistogram</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.awaitility</groupId>\n      <artifactId>awaitility</artifactId>\n      <scope>test</scope>\n    </dependency>\n    <dependency>\n      <groupId>org.zapodot</groupId>\n      <artifactId>embedded-ldap-junit</artifactId>\n      <scope>test</scope>\n    </dependency>\n  </dependencies>\n  <build>\n    <plugins>\n      <plugin>\n        <groupId>org.apache.maven.plugins</groupId>\n        <artifactId>maven-dependency-plugin</artifactId>\n        <version>3.0.2</version>\n        <executions>\n          <execution>\n            <id>unpack-classes</id>\n            <phase>prepare-package</phase>\n            <goals>\n              <goal>unpack</goal>\n            </goals>\n            <configuration>\n              <artifactItems>\n                <artifactItem>\n                  <groupId>org.apache.logging.log4j</groupId>\n                  <artifactId>log4j-core-java9</artifactId>\n                  <version>${project.version}</version>\n                  <type>zip</type>\n                  <overWrite>false</overWrite>\n                </artifactItem>\n              </artifactItems>\n              <includes>**/*.class</includes>\n              <excludes>**/*.java</excludes>\n              <outputDirectory>${project.build.directory}</outputDirectory>\n              <overWriteReleases>false</overWriteReleases>\n              <overWriteSnapshots>true</overWriteSnapshots>\n            </configuration>\n          </execution>\n        </executions>\n      </plugin>\n      <plugin>\n        <groupId>org.codehaus.mojo</groupId>\n        <artifactId>build-helper-maven-plugin</artifactId>\n        <version>1.7</version>\n        <executions>\n          <execution>\n            <id>add-source</id>\n            <phase>generate-sources</phase>\n            <goals>\n              <goal>add-source</goal>\n            </goals>\n            <configuration>\n              <sources>\n                <source>${project.build.directory}/log4j-core-java9</source>\n              </sources>\n            </configuration>\n          </execution>\n        </executions>\n      </plugin>\n      <plugin>\n        <artifactId>maven-compiler-plugin</artifactId>\n        <executions>\n          <execution>\n            <!-- disable annotation processing for first pass -->\n            <id>default-compile</id>\n            <configuration>\n              <excludes>\n                <exclude>module-info.java</exclude>\n              </excludes>\n              <proc>none</proc>\n            </configuration>\n          </execution>\n          <execution>\n            <!-- then do a processing-only pass to generate plugins .dat file -->\n            <id>process-plugins</id>\n            <goals>\n              <goal>compile</goal>\n            </goals>\n            <phase>process-classes</phase>\n            <configuration>\n              <excludes>\n                <exclude>module-info.java</exclude>\n              </excludes>\n              <proc>only</proc>\n            </configuration>\n          </execution>\n        </executions>\n      </plugin>\n      <plugin>\n        <artifactId>maven-surefire-plugin</artifactId>\n        <configuration>\n          <excludedGroups>\n            org.apache.logging.log4j.categories.PerformanceTests\n          </excludedGroups>\n          <systemPropertyVariables>\n            <org.apache.activemq.SERIALIZABLE_PACKAGES>*</org.apache.activemq.SERIALIZABLE_PACKAGES>\n          </systemPropertyVariables>\n        </configuration>\n      </plugin>\n      <plugin>\n        <groupId>org.apache.maven.plugins</groupId>\n        <artifactId>maven-failsafe-plugin</artifactId>\n        <configuration>\n          <skipTests>true</skipTests>\n        </configuration>\n      </plugin>\n      <plugin>\n        <groupId>org.apache.maven.plugins</groupId>\n        <artifactId>maven-jar-plugin</artifactId>\n        <executions>\n          <execution>\n            <id>default-jar</id>\n            <goals>\n              <goal>jar</goal>\n            </goals>\n            <configuration combine.self=\"override\">\n              <archive>\n                <manifestFile>${manifestfile}</manifestFile>\n                <manifestEntries>\n                  <Specification-Title>${project.name}</Specification-