# Explicit environment values override these placeholders.
KALAMA_LLM_ENABLED=false
KALAMA_LLM_PROVIDER=ollama
KALAMA_LLM_MODEL=llama3.2:3b
KALAMA_LLM_BASE_URL=http://127.0.0.1:11434
# KALAMA_LLM_API_KEY=

# Future EvidenceSource adapters. No network adapter is enabled by Task 1.
KALAMA_EVIDENCE_RUNTIME_ENABLED=true
KALAMA_EVIDENCE_KNOWLEDGE_ENABLED=true
KALAMA_EVIDENCE_MSF_METADATA_ENABLED=true
KALAMA_EVIDENCE_MSF_MODULE_DOC_ENABLED=true
KALAMA_EVIDENCE_MSF_REFERENCE_ENABLED=true
KALAMA_EVIDENCE_VENDOR_UPSTREAM_ENABLED=false
KALAMA_EVIDENCE_NVD_ENABLED=false
KALAMA_EVIDENCE_CISA_KEV_ENABLED=true
